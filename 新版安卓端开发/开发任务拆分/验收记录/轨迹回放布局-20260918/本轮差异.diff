+  String _clock(Object? raw, {bool seconds = false}) {
+    final time = DateTime.tryParse('$raw')?.toLocal();
+    if (time == null) return '--:--';
+    final base =
+        '${time.hour.toString().padLeft(2, '0')}:${time.minute.toString().padLeft(2, '0')}';
+    return seconds ? '$base:${time.second.toString().padLeft(2, '0')}' : base;
+  }
