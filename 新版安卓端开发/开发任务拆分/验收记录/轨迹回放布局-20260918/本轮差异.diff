+/// Normalized positions belong only to the explicitly labelled plant preview.
+class _TrackPreviewPainter extends CustomPainter {
+  const _TrackPreviewPainter(this.index);
+  final int index;
+  static const route = [
+    Offset(.18, .78),
+    Offset(.24, .64),
+    Offset(.38, .64),
+    Offset(.52, .64),
+    Offset(.52, .48),
+    Offset(.52, .30),
+    Offset(.52, .22),
+    Offset(.65, .22),
+    Offset(.78, .22),
+  ];
+  @override
+  void paint(Canvas canvas, Size size) {
+    final points = route
+        .map((p) => Offset(p.dx * size.width, p.dy * size.height))
+        .toList();
+    final path = Path()..moveTo(points.first.dx, points.first.dy);
+    for (final point in points.skip(1)) {
+      path.lineTo(point.dx, point.dy);
+    }
+    canvas.drawPath(
+      path,
+      Paint()
+        ..color = Colors.white
+        ..strokeWidth = 6
+        ..style = PaintingStyle.stroke
+        ..strokeJoin = StrokeJoin.round,
+    );
+    canvas.drawPath(
+      path,
+      Paint()
+        ..color = const Color(0xFF008FFF)
+        ..strokeWidth = 3
+        ..style = PaintingStyle.stroke
+        ..strokeJoin = StrokeJoin.round,
+    );
+    final current = points[index.clamp(0, points.length - 1)];
+    canvas.drawCircle(current, 7, Paint()..color = Colors.white);
+    canvas.drawCircle(current, 5, Paint()..color = const Color(0xFF008FFF));
+    final label = TextPainter(
+      text: const TextSpan(
+        text: '陈建国 · 示例',
+        style: TextStyle(
+          color: Colors.white,
+          fontSize: 10,
+          fontWeight: FontWeight.w600,
+        ),
+      ),
+      textDirection: TextDirection.ltr,
+    )..layout();
+    final rect = Rect.fromLTWH(
+      (current.dx - label.width / 2 - 6).clamp(
+        4,
+        size.width - label.width - 16,
+      ),
+      current.dy - 30,
+      label.width + 12,
+      22,
+    );
+    canvas.drawRRect(
+      RRect.fromRectAndRadius(rect, const Radius.circular(5)),
+      Paint()..color = const Color(0xFF008FFF),
+    );
+    label.paint(canvas, Offset(rect.left + 6, rect.top + 4));
+  }
+
+  @override
+  bool shouldRepaint(_TrackPreviewPainter oldDelegate) =>
+      oldDelegate.index != index;
+}
