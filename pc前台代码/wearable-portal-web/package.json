{
  "name": "wearable-portal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9"
  },
  "scripts": {
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 5180 --strictPort",
    "test:unit": "node --test scripts/*.test.mjs",
    "dev": "vite --mode development",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo",
    "build:prod": "vite build --mode production",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview --port 5177 --strictPort",
    "lint": "eslint . --ext .js,.vue --max-warnings 0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.0.10",
    "axios": "0.27.2",
    "element-plus": "2.2.27",
    "mpegts.js": "1.8.2",
    "ol": "7.5.2",
    "pinia": "2.0.22",
    "vue": "3.5.12",
    "vue-router": "4.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/compiler-sfc": "3.5.12",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.25.0",
    "sass": "1.56.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "5.4.21"
  }
}
