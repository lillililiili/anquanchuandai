{
    admin off
    # Credential paths must not appear in proxy errors or access logs.
    log default {
        output discard
    }
}
(backend_pool) {
    lb_policy round_robin
    lb_retries 0
    health_uri /internal/cluster/ready
    health_interval 2s
    health_timeout 1500ms
    health_status 200
    health_body `"ready"\s*:\s*true`
}
(gateway_pool) {
    lb_policy round_robin
    lb_retries 0
    health_uri /internal/gateway/ready
    health_interval 2s
    health_timeout 1500ms
    health_status 200
    health_body `"ready"\s*:\s*true`
}
{$CADDY_SITE} {
    # Use route to preserve security handler ordering before generated matches.
    route {
        @private path /internal /internal/* /druid /druid/* /actuator /actuator/* /wsHat /wsBelt /api/index.php /api/belt/* /api/upload
        respond @private 404
        import /etc/caddy/Caddy.devices
        reverse_proxy app-a:18084 app-b:18084 {
            import backend_pool
        }
    }
}
