          "alarmContent",
          "rawAlarmType",
          "rawAlarmName",
          "alarmOrigin",
          "positionSource",
          "position",
          "positionAgeSeconds"
        ],
        "additionalProperties": false,
        "description": "Immutable first occurrence only; business processing, claim or verification is not an alarm clear. Current implementation exports confirmed SOS and UNKNOWN with original vendor code; other enum values are reserved until verified. Historical times can be null when unrecoverable.",
        "allOf": [
          {
            "if": {
              "properties": {
                "positionSource": {
                  "const": "NONE"
                }
              }
            },
            "then": {
              "properties": {
                "position": {
                  "type": "null"
                },
                "positionAgeSeconds": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "position": {
                  "$ref": "#/components/schemas/Position"
                },
                "positionAgeSeconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 300
                }
              }
            }
          }
        ]
      },
      "ALARMEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "eventId",
          "eventType",
          "trigger",
          "occurredAt",
          "createdAt",
          "data"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "eventId": {
            "type": "string",
            "pattern": "^FP-[0-9a-f]{64}$",
            "description": "Stable delivery ID. Deduplicate before confirming receipt."
          },
          "eventType": {
            "type": "string",
            "const": "ALARM"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "ALARM"
            ]
          },
          "occurredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Original observation time, not HTTP arrival time."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "$ref": "#/components/schemas/AlarmItem"
          }
        }
      }
    },
    "securitySchemes": {
      "HmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "Lowercase HMAC-SHA256 hex of POST, actual raw path, X-App-Id, X-Timestamp, X-Nonce, body SHA256 joined with LF; no trailing LF. Decode the 32-byte Base64 secret first."
      }
    }
  }
}
