            "type": "string",
            "const": "POSITION"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "REPORT"
            ]
          },
          "occurredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Original observation time, not HTTP arrival time."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "$ref": "#/components/schemas/PositionItem"
          }
        }
      },
      "StatusItem": {
        "type": "object",
        "properties": {
          "sourcePlatform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "deviceType": {
            "type": "string",
            "enum": [
              "HELMET",
              "SAFETY_BELT"
            ]
          },
          "deviceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
