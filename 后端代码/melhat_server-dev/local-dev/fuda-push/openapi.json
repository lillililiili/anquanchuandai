                  }
                },
                "network": {
                  "properties": {
                    "validity": {
                      "not": {
                        "const": "VALID"
                      }
                    }
                  }
                },
                "wear": {
                  "properties": {
                    "validity": {
                      "not": {
                        "const": "VALID"
                      }
                    }
                  }
                },
                "hookA": {
                  "properties": {
                    "validity": {
                      "not": {
                        "const": "VALID"
                      }
                    }
                  }
                },
                "hookB": {
                  "properties": {
                    "validity": {
                      "not": {
                        "const": "VALID"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
