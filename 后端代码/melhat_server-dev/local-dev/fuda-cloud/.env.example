# This file is a template, never a production credential source.
FUDA_MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_ROOT_SECRET
FUDA_MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_APPLICATION_SECRET
FUDA_REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_SECRET
MELHAT_BUSINESS_MEDIA_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_MEDIA_KEY
FUDA_BACKEND_IMAGE=fuda-wearable-backend:2.0.0
# Copy separately to .env.staging and .env.production with independent DB/Redis secrets.
# Ports/project names are deliberately not environment-selectable.
# compose.yml: staging, query 127.0.0.1:18089, no backend host port.
# compose.yml + compose.production.yml: production, backend 127.0.0.1:18084, query 10.255.1.1:28089.
# Do not set COMPOSE_PROJECT_NAME or use -p to override the controlled names.
