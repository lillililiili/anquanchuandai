# Copy to .env locally; never commit real credentials.
MELHAT_DEMO_MODE=false
# 1020 safety-belt protocol. Kept independent of the helmet configuration.
MELHAT_BELT_ENABLED=false
MELHAT_BELT_PUBLIC_BASE_URL=
MELHAT_BELT_API_URL=
MELHAT_BELT_WS_URL=
MELHAT_BELT_HEARTBEAT_TIMEOUT_SECONDS=45
# Leave these empty until the vendor confirms the actual firmware's values.
MELHAT_BELT_WORN_VALUE=
MELHAT_BELT_UNWORN_VALUE=
MELHAT_BELT_HOOKED_VALUE=
MELHAT_BELT_UNHOOKED_VALUE=
# RD-D1+ direct device protocol. Use an address reachable by the helmet.
MELHAT_DIRECT_ENABLED=false
MELHAT_DIRECT_PUBLIC_BASE_URL=
# Optional HTTP directory override (trailing slash); default is PUBLIC_BASE_URL/api/.
MELHAT_DIRECT_API_URL=
MELHAT_DIRECT_WS_URL=
MELHAT_DIRECT_HEARTBEAT_TIMEOUT_SECONDS=45
HEADBAND_SERVER=https://api.hel.epplink.com:30090
TOKEN_SERVICE_USERNAME=
TOKEN_SERVICE_PASSWORD=
# Optional self-hosted helmet media. Keep disabled until cloud health checks pass.
# The HMAC key belongs only in the ignored .env, never in UI or device config.
MELHAT_HELMET_MEDIA_ENABLED=false
MELHAT_HELMET_MEDIA_CONTROL_URL=https://lingzhiaide.com/helmet-media/control/v1
MELHAT_HELMET_MEDIA_SHARED_KEY=
# Base64-encoded 32-byte AES key for private media SQL storage. Keep the same key
# with protected database backups; never commit the real value or regenerate on restart.
MELHAT_BUSINESS_MEDIA_ENCRYPTION_KEY=
