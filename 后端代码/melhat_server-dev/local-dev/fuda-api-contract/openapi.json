    "/openapi/wearables/v2/alarms/query": {
      "post": {
        "operationId": "queryAlarms",
        "summary": "Query alarms",
        "description": "Fuda initiates this read-only query against our platform. No query string, compression, trailing slash, Authorization or X-Wearable-Token. Body <=65536 bytes. Alarm responses use a persistent committed-order cursor, not event time or page number.",
        "security": [
          {
            "ApplicationId": []
          }
        ],
        "parameters": [
          {
            "name": "X-App-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "description": "Dedicated partner application ID; human login sessions are rejected."
          },
          {
            "name": "X-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,12}$"
            },
            "description": "Unix seconds; server permits clock skew up to 300 seconds."
          },
          {
            "name": "X-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
