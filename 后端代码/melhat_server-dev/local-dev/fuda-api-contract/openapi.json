{
  "openapi": "3.1.0",
  "info": {
    "title": "智能穿戴平台—福大 V2 主动拉取接口",
    "version": "2.0.0",
    "description": "Implementation contract for the isolated backend. Default disabled; deployment and joint acceptance are still required. Three HTTP query endpoints; GB/T 28181-2022 video uses a separate cascade contract. Source platform identifier must remain stable. Credentials and authorized devices are private configuration. Alarm cursor is bound to app/key and current authorized real-device set; losing/changing scope/key requires controlled resynchronization. No automatic journal deletion in this release. Repeated cursor reads are safe; receiver deduplicates stable event IDs. Position/status provide latest snapshots, not complete intermediate history."
  },
  "servers": [
    {
      "url": "https://wearable-api.example.invalid",
      "description": "Placeholder; replace only with the accepted test/production base URL."
    }
  ],
  "paths": {
    "/openapi/wearables/v2/positions/query": {
      "post": {
        "operationId": "queryPositions",
        "summary": "Query positions",
        "description": "Fuda initiates this read-only query against our platform. No query string, compression, trailing slash, Authorization or X-Wearable-Token. Body <=65536 bytes. Response preserves request device order.",
        "security": [
          {
            "ApplicationId": []
          }
        ],
        "parameters": [
          {
            "name": "X-App-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "description": "Dedicated partner application ID; human login sessions are rejected."
          },
          {
            "name": "X-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,12}$"
            },
            "description": "Unix seconds; server permits clock skew up to 300 seconds."
          },
          {
            "name": "X-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "description": "New UUID per HTTP attempt; replay identity is case-insensitive within this application; stored atomically for at least 600 seconds (implementation 601 seconds covers inclusive clock-window boundaries)."
          },
          {
            "name": "X-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "Lowercase HMAC-SHA256 of six newline-separated fields: POST, exact full path, appId, timestamp, nonce, lowercase SHA256(raw UTF-8 body). No trailing newline. Secret is Base64-decoded into exactly 32 bytes, not used as UTF-8 text."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query succeeded. Persist a complete alarm page locally before advancing nextCursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionResponse"
                }
              }
            }
          },
          "400": {
            "description": "40001 invalid request; 40002 invalid/tampered cursor or changed scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "40101 invalid credentials or human session provided; 40102 timestamp outside window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "40301 device scope denied; whole batch rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "40401 gateway method or route not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "40902 nonce already used: retry with new timestamp/nonce/signature; 40903 cursor ahead of durable journal: restore/recovery required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "41001 retained cursor has expired; coordinate historical recovery, never silently reset to newest.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "41301 body exceeds 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "41501 unsupported content type or content encoding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "42901 gateway rate limit; retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "50201 gateway cannot reach upstream.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "50300 temporary service failure; 50301 replay store unavailable; 50302 API disabled; 50303 application configuration invalid; 50304 device registry unavailable/ambiguous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
