# 页面标题
VITE_APP_TITLE = 智能穿戴管理平台

# 生产环境配置
VITE_APP_ENV = 'production'

# xxx系统 / 生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 旧版实时控制台仅用于受控回退，生产默认关闭
VITE_ENABLE_LEGACY_CONSOLE = 'false'

# SOCKET地址
VITE_APP_SOCKET_URL = 'wss://111.229.163.236:26443/t-prod-api'

# 瓦片地图地址
VITE_APP_MAP_TILES_URL = 'https://111.229.163.236:26443/tiles'
